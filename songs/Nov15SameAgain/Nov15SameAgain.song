# SameAgain Test

# cargo run --release -p song_text --example song_play_test -- ~/Documents/Live_Lead_Sheet/songs/Nov15SameAgain/Nov15SameAgain.song ~/Documents/Live_Lead_Sheet/songs/Nov15SameAgain/Nov15SameAgain.studio

song "Same Again Test"

track "Clock"
  type clock_and_transport

track "NTBass"
  type mono_voice
  notes pitched
  clef bass
  lead


song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"  repeat 2
  "B"  repeat 2
  "C"
  "A"  repeat 2
song_composition_close

section "A"
  key C major
  meter 4/4  tempo 100 beats/min
  line "NTBass"  tonic_octave 2   | M2:e_ M6:e_ P4:e_ M2:e  M6:e_ P5:e_ P4:e  r:e  | P8:h_  /  |  
                                  | M2:e  M6:e  P4:e  M2:e  M6:e  r:e   P4:e  r:e  | P1:h   /  |  

section "B"
  key C major
  meter 4/4  tempo 100 beats/min
  line "NTBass"  tonic_octave 2  sample_source    | M2    M6   P4   M2  M13  P12  P11  P4             | P8     M2    |
  line "NTBass"  tonic_octave 2                   | :e_   :e_  :e_  :e  :e_  /  /   r:e            | P8:h_  M2:h  |  

section "C"  meter 4/4  key C major
  line "NTBass"  tonic_octave 2                   | M2:e_  /    P4:e  M2:e  M6:e  r:e   P4:e  r:e  | P8:h   M9:h  |  


#section "B" repeat 2

  
                  
