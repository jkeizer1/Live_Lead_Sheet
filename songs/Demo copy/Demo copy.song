# Demo song for the Live Lead Sheet: a two-bar count-in, then a two-bar
# verse that plays twice. It names no port, channel or device; Demo.studio
# says where each track goes.
# Tossed 24 Nov 2026 (line 16): jim was here
# Tossed 26 Nov 2026 (line 41): line "Keys"  sample_source    | I | |      |
# Tossed 26 Nov 2026 (line 43): line "Keys"                   | r:w | r: w |
song "Demo Copy"

track "Clock"
  type clock_and_transport

track "Beat"
  type mono_voice
  notes midi_note
  clef treble
  lead

#track "Cues"
#  type cue_control
#  cue "Start SQ-1"  destination "SQ-1"  start

song_composition
  key C major  meter 4/4  tempo 490 beats/min
  "Count-in"  repeat 1
  "Verse ONE"  repeat 8
song_composition_close

section "Count-in"  count-in
  key C major
  meter 4/4  
  line "Beat"  | C4:q> / / / |

# C – G – Am – F
section "Verse ONE"
  key C major  meter 4/4
#line "Keys" sample_source | I | I |
#line "Keys" | r:w | r:w |
line "Beat"  | E5:q> C5> G5> C5> | F4> C4 C5 C6 |


