# System35 legato and general test
# cargo run --release -p song_text --example song_play_test -- songs/system35.song songs/system35.studio

song "System35 Testing"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass

track "NTBass"
  type mono_voice
  notes pitched
  clef bass
  lead

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "tune"  repeat 2
  "1"  repeat 120
song_composition_close

section "tune"
  key C major
  meter 4/4  tempo 100 beats/min
  line "Bass"  tonic_octave 3     | -m3:w |

section "1"  meter 4/4  key C major

  line "Bass"  tonic_octave 1     | M9:e_ M13:e_ P11:e_ M9:e  M13:e_ P12:e_ P11:e  r:e  | P15:h_  M9:h  |  
                  | M9:e  M13:e  P11:e  M9:e  M13:e  r:e   P11:e  r:e  | P8:h   M2:h  |  

  line "NTBass"  tonic_octave 1   | M9:e_ M13:e_ P11:e_ M9:e  M13:e_ P12:e_ P11:e  r:e  | P15:h_  M9:h  |  
                  | M9:e  M13:e  P11:e  M9:e  M13:e  r:e   P11:e  r:e  | P8:h   M2:h  |  
                  
