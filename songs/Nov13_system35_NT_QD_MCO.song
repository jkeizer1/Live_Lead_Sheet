# System35 legato and general test
# cargo run --release -p song_text --example song_play_test -- songs/Nov13_system35_NT_QD.song songs/Nov13_system35_NT_QD.studio

song "System35 Testing"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

track "VPME_Blue"
  type mono_voice
  clef bass

track "MCO_SID"
  type mono_voice
  clef bass

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "tune"  repeat 2
  "unison"  repeat 2
  "1"  repeat 2
  "2"  repeat 2
  "3"  repeat 4
  "4"  repeat 2
  "5"  repeat 4
song_composition_close

section "tune"
  key C major
  meter 4/4  tempo 100 beats/min
  line "Bass"     | D1:w |

section "unison"  meter 4/4
  line "Bass"                    | D2:w  |

  line "MCO_SID" sample_source   | D2    |
  line "MCO_SID"                 | :w    |
                   

section "1"  meter 4/4
    
  line "Bass"                    | D2:e_ A2:e_ F2:e_ D2:e  A2:e_ G2:e_ F2:e  r:e  | C2:h_  E2:h           | D2:e  A2:e  F2:e  D2:e  A2:e  r:e   A3:e  r:e       | C2:h_   D1:h  |  

  line "VPME_Blue" sample_source | D1                                             | C1                    | D1                                                  | C1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID" sample_source   |  D1                                            |  C1                   | D1                                                  | C1 G2 D1 A2   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                  
                   

section "2"  meter 4/4
    
  line "Bass"                    | F2:e_ A2:e_ F2:e_ C2:e  A2:e_ C2:e_ F2:e  r:e  | C2:h_  G2:h           | B3:e  G1:e  E2:e  G1:e_  B3:e  r:e   B2:e  r:e      | C2:h_   D1:h  |  

  line "VPME_Blue" sample_source | F1                                             | C1                    | B1                                                  | C1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID" sample_source   | F1                                             |  C1                   | B1                                                  | C1 G2 D1 A2   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                     

section "3"  meter 4/4
    
  line "Bass"                    | D2:e_ A2:e_ F2:e_ D2:e  A2:e_ G2:e_ F2:e  r:e  | C2:h_  E2:h           | D2:e  A2:e  F2:e  D2:e  A2:e  r:e   A3:e  r:e       | C2:h_   D1:h  |  

  line "VPME_Blue" sample_source | D1                                             | C1                    | D1                                                  | C1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID" sample_source   |  D1                                            |  C1                   | D1                                                  | C1 G2 D1 A2   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |   

section "4"  meter 4/4
    
  line "Bass"                    | F2:e_ A2:e_ F2:e_ C2:e  A2:e_ C2:e_ F2:e  r:e  | C2:h_  G2:h           | B3:e_  G1:e  E2:e  G1:e_  B3:e  r:e   B2:e  r:e     | C2:h_   D1:h  |  

  line "VPME_Blue" sample_source | F1                                             | C1                    | B1                                                  | C1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID" sample_source   | F1                                            |  C1                    | B1                                                  | C1 G2 D1 A2   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                     

section "5"  meter 4/4
    
  line "Bass"                    | D2:e_ A2:e_ F2:e_ D2:e  A2:e_ G2:e_ F2:e  r:e  | C2:h_  E2:h           | D2:e  A2:e  F2:e  D2:e  A2:e  r:e   A3:e  r:e       | C2:h_   D1:h  |  

  line "VPME_Blue" sample_source | D1                                             | C1                    | D1                                                  | C1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID" sample_source   |  D1                                            |  C1                   | D1                                                  | C1 G2 D1 A2   |
