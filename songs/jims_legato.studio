# Demo studio: where the tracks of Demo.song go. Port names are the names
# of the program's MIDI output ports; connecting them to devices is done
# outside (the MIDI router, aconnect).
studio "Demo studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"
#port "To SQ-1"
port "QD-Cymbol"

track "Clock"
  port "Clock"

track "Keys"
  port "Harmony"  channel 1
  velocity mezzo_forte 50  accent 60  marcato 80

track "Beat"
  port "Beat pulse"  channel 15
  velocity mezzo_forte 75  accent 90 marcato 127
  octave_offset 0 octaves

track "Bass"
  port "Bass"  channel 2
  octave_offset 0 octaves
  velocity mezzo_forte 90  accent 115
  retrigger_gap 2 ms

track "Cymbol" 
  port "QD-Cymbol" channel 4


#destination "SQ-1"
#  port "To SQ-1"  channel 1
