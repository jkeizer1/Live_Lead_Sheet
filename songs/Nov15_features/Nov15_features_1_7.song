# One section per new feature (Nov 15 list, items 1 to 7). Adjust anything and listen.
# To hear it (connect the ports Clock, Harmony, Bass and Beat pulse first):
#   cargo run --release -p song_text --example song_play_test -- songs/Nov15_features/Nov15_features_1_7.song songs/Nov15_features/Nov15_features_1_7.studio
# Keys is the chord instrument, Bass plays single notes, Beat plays the euclid rhythms.
song "Nov 15 features 1 to 7"
chord_numeral_standard key_dependent --- for minor keys; used to determine the root note
#chord_numeral_standard major_referential


track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

# 1. GROUPING. 7/8 grouped 2+2+3 eighths: three beats, two short and one long. Played twice.
#    In 7/8 the beat is an eighth note, so 200 beats/min is a quarter note at 100.
#    Listen: the bass steps fall on the groups (short, short, long).
song_composition
  key C major  meter 7/8 grouping 2+2+3  tempo 400 beats/min
  "1 grouping"  repeat 0
  "2 inversions"  repeat 0
  "3 repeat signs"  repeat 0
  "4 F minor"  repeat 2
  "4 F Major"  repeat 2
  "4 euclid B"  repeat 0
  "5 layer merge"  repeat 0
  "6 dynamic levels"  repeat 0
  "6b crescendo diminuendo"  repeat 0
  "6b2crescendo diminuendo"  repeat 0
  "6c accent under p"  repeat 0
  "7 octaves"  repeat 0
  "8a slow"  repeat 0
  "8b faster"  repeat 0
  "8c three four"  repeat 0
  "8ca three four"  repeat 0
  "8d six eight"  repeat 0
  "8e back to slow"  repeat 0
song_composition_close

section "1 grouping"
  key C major  meter 7/8  grouping 2+2+3  tempo 400 beats/min
  line "Keys"  | I:q ii:q V:q.    |
  line "Bass"  tonic_octave 2  | P1:q M2:q P5:q.  |
  line "Beat"  | C2:q / C2:e / /  |

# 2. INVERSIONS. The same C chord four ways, then ii7 in third inversion.
#    Listen: the lowest note of the chord changes: C, E, G, then C7... (ii7 = D F A C: C lowest).
section "2 inversions"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w  | I[1stInversion]:w | I[2ndInversion]:w | ii7[3rdInversion]:w |
  line "Bass"  tonic_octave 2  | P1:w | /                 | /                 | /                   |

# 3. REPEAT SIGNS. |% ... %| plays the two bars inside twice: I, IV, V, IV, V, I.
section "3 repeat signs"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w   |% IV:w | V:w  %| I:w  |
  line "Bass"  tonic_octave 2  | P1:w  |% P4:w | P5:w %| P1:w |

# 4. EUCLID. Three hits spread over eight steps, then five over eight: Bjorklund's patterns
#    (x..x..x. and x.xx.xx.). Listen: the Beat track.
#    minor dominant uses Eb
section "4 F minor"
#  key C major  meter 4/4  tempo 7999 beats/min --- 8000 beats/min is too fast (rejected), 7999 bpm works.
   key F minor  meter 4/4  tempo 140 beats/min --- 8000 beats/min is too fast (rejected), 7999 bpm works.
#                             | Fm (F Ab C), Bb minor (Bb Db F)    |      Cm (C Eb G) Fm (F Ab C)   |
   line "Keys" sample_source  | I              IV                  |      V           I             |
   line "Keys"                | :h             :h                  |+8va  :h          :h            |
   line "Bass"  tonic_octave 1                | P8:trp(q q q)  M9:h                | P5:trp(q q q)    P8:q m3:q    |

#   line "Beat"                | C2:q / / /      |  C2: / / C2:trp(e e e)   |

# 4. EUCLID. Three hits spread over eight steps, then five over eight: Bjorklund's patterns
#    (x..x..x. and x.xx.xx.). Listen: the Beat track.
section "4 F Major"
#  key C major  meter 4/4  tempo 7999 beats/min --- 8000 beats/min is too fast (rejected), 7999 bpm works.
   key F major  meter 4/4  tempo 140 beats/min --- 8000 beats/min is too fast (rejected), 7999 bpm works.
   line "Keys" sample_source  | I  vi                     |      IV          vii°          |
   line "Keys"                |  :w                       |+8va  :h :trp(q q q)            |
   line "Bass"  tonic_octave 1                | trp(P8:q M10:q P5:q)  M6:h | P11:trp(q q q)    M7:q -P4:q    |
#   line "Beat"               | C2:q / / /                |  C2: / / C2:trp(e e e)         |

# 4. EUCLID. Three hits spread over eight steps, then five over eight: Bjorklund's patterns
#    (x..x..x. and x.xx.xx.). Listen: the Beat track.
section "4 euclid B"
  key C major  meter 8/8  tempo 420 beats/min
   line "Keys"  |%2 I:w      | -8va V:w  %|%2 loco ii:w | V:w %|
   line "Bass"  tonic_octave 3  | P5:q / / / | -P4:euclid(3,8)                       |  -P4:euclid(4,8)          |  -P4:euclid(5,6)          |  -P4:euclid(2,3)          | -P4:euclid(7,8)          | -P4:euclid(8,8) |  r:w |       
   line "Beat"  | G3:q / / / |%6 C2:e r:e r:e r:e C3 r:e r:e r:e   %|  C2:q B2:q C3:q C4:q |

# 5. SAME PITCH IN TWO LAYERS. Bar 1: layer 1 holds C4 on beats 1-2, layer 2 on beats 2-3:
#    one C4 sounds from beat 1 to the end of beat 3. Bar 2: the C4s only touch (beat 1, then beat 2):
#    two separate notes.
section "5 layer merge"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys" voice_layer 1  tonic_octave 4  | P1:h r:h       | P1:q r:h.    |
  line "Keys" voice_layer 2  tonic_octave 4  | r:q  P1:h> r:q | r:q P1:q r:h |
  line "Bass"  tonic_octave 2                | P1:w           | /            | 
  line "Beat"                | C2:q / / /     | / / / /      |
 
# 6. DYNAMICS. A line "Keys" dynamics: the six levels, one bar each: pp p mp mf f ff.
#    Listen: the chord on Keys gets louder bar by bar (Bass stays the same).
section "6 dynamic levels"
  key C major  meter 4/4  tempo 140 beats/min
  line "Keys"            | I:w  | / | I:w  | /  | / | /  |
  line "Keys"  dynamics  | pp:w | p | mp | mf | f | ff |
#  line "Bass"            | C2:w | / | /  | /  | / | /  |

# 6b. CRESCENDO AND DIMINUENDO. p, then a crescendo over two bars to f, then a diminuendo over
#     two bars to p, then mf. The < and > end where the next level starts.
section "6b crescendo diminuendo"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w | / | / | / | / | / | / | / |
  line "Keys"  dynamics  | pp:w | <:w | r:w | f:w | >:w | r:w | p:w | mf:w |
  line "Bass"  tonic_octave 2            | P1:w    | / |   / | / | / | / | / | / |
  line "Bass"  dynamics  | pp:w    | <:w | r:w | f:w | >:w | r:w | p:w | mf:w |

# 6b2. CRESCENDO AND DIMINUENDO. p, then a crescendo over two bars to f, then a diminuendo over
#     two bars to p, then mf. The < and > end where the next level starts.
section "6b2crescendo diminuendo"
  key C major  meter 4/4  tempo 100 beats/min
   line "Bass"  tonic_octave 2            | P1:w    | / |   / | / | / | / | / | / |
   line "Bass"  dynamics  | pp:w    | <:w | r:w | f:w | >:w | r:w | p:w | mf:w |

# 6c. ACCENT UNDER p. The studio's accent (velocity 100) is absolute: the first chord in the
#     bar is loud though the line says p. The next bar's < marks are softer than p.
section "6c accent under p"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"            | I:q> / / / | I:q< / / / |
  line "Keys"  dynamics  | p:w        | r:w        |
#  line "Bass"            | C2:w       | /          |
  line "Beat"            | C2:q / / / | / / / /    |

# 7. OCTAVE ANNOTATIONS. C E G C each bar: plain, then +8va (an octave up, stays on), then plain
#    text still up, then -8va (an octave down), then loco (back to the clef's octave).
section "7 octaves"
  key C major  meter 4/4  tempo 150 beats/min
  line "Keys"  tonic_octave 4  | P1:q M3 P5 P8 | +8va P1:q M3 P5 P8 | P1:q M3 P5 P8 | -8va P1:q M3 P5 P8 | loco P1:q M3 P5 P8 | r:w               |
  line "Bass"  tonic_octave 2  | P1:w          | /                  | /             | /                  | /                  | P1:q> /<< /<< /<< |

# 8. TEMPO BETWEEN SECTIONS (and the meter change). 100 beats/min, then 140, then 3/4 keeps
#    140 beats/min (same beat speed), then 6/8 keeps 140 beats/min (the beat is now a dotted
#    quarter, so it feels faster), then back to 4/4 at 100.
section "8a slow"
  key C major  meter 4/4 
  tempo 100 beats/min
  line "Keys"  | I:w        | IV:w    |
  line "Bass"  tonic_octave 2  | P1:w       | P4:w    |
  line "Beat"  | C2:q / / / | / / / / |

section "8b faster"
  key C major  meter 4/4 
  tempo 140 beats/min
  line "Keys"  | V:w        | I:w     |
  line "Bass"  tonic_octave 2  | P5:w       | P1:w    |
  line "Beat"  | C2:q / / / | / / / / |

section "8c three four"
  key C major meter 3/4
  tempo 140 beats/min
  line "Keys"  | I:h.      | IV:h. | V:h.  | I:h.  |
  line "Bass"  tonic_octave 2  | P1:h.     | P4:h. | P5:h. | P1:h. |
  line "Beat"  | C2:q / /  | / / / | / / / | / / / |

section "8ca three four"
  key C major meter 3/4
  tempo 140 beats/min
#  line "Keys"  | I:h.      | IV:h. |
#  line "Bass"  | C2:h.     | F2:h. |
  line "Beat"  | C2:q / /  | / / / |

section "8d six eight"
  key C major meter 6/8
  tempo 140 beats/min
  line "Keys"  | I:h.                       | IV:h.                     | V:h.                      | I:h.                      |
#  line "Bass" | C2:h.                      | F2:h.                     | G2:h.                     | C2:h.                     |
  line "Beat"  |%4 C2:e r:e C2:e C2:e r:e C2:e %| 

section "8e back to slow"
  key C major meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w |
  line "Bass"  tonic_octave 2  | P1:w |
