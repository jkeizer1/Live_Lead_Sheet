# System35 NT Test
studio "System35 Studio"

port "Clock"
port "Bass"
port "NTBass"

track "Clock"
  port "Clock" channel 16

track "Bass"
  port "Bass"  channel 1
  octave_offset -1 octaves
  velocity normal 90  accent 115
  retrigger_gap 100 ms

track "NTBass"
  port "NTBass"  channel 2
  octave_offset 2 octaves
  velocity normal 90  accent 115
  retrigger_gap  2 ms

