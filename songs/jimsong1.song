# ALL NT
# NT Preset Nov7

song "Nov7 General Testing"

track "Clock"
  type clock_and_transport

track "Harmony"
  type poly_voice
  clef grand
  lead

track "Beat"
  type mono_voice
  clef treble

track "Bass"
  type mono_voice
  clef bass

section "Gate test"  repeat 300
  key C major  meter 3/8  tempo 180 beats/min
  line "Harmony"  | e:I e e:V7                       | e:IV           sx:iidim  sxr        e:ii     | 
  line "Bass"     | sx:C2 sx:G2 e:E2 sxr sx:C4       | sx:F2 sx:A3    e:B3         sx:B2 sxr    |
# line "Beat"     | sx>:C5 sxr  sx:B3 sxr  sx sx:C4  | sx>:C5 sxr     sx:B3 sx     sx sx:C6 |
  line "Beat"     | sx>:C6 sxr  sx:B3 sxr  sx sxr    | sx>:C5 sxr     er           sx:C8 sxr|
