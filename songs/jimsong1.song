# ALL NT
# NT Preset Nov7

song "Nov7 General Testing"

track "Clock"
  type clock_and_transport

track "Harmony"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

track "Bass"
  type mono_voice
  notes pitched
  clef bass

song_composition
  key C major  meter 3/8  tempo 180 beats/min
  "Gate test"  repeat 300
song_composition_close

section "Gate test"
  key C major  meter 3/8  tempo 180 beats/min
  line "Harmony"  | I:e / V7                         | IV           iidim:sx  r        ii:e         | 
  line "Bass"  tonic_octave 2     | P1:sx P5 M3:e r:sx P15            | P4 M13    M14:e         M7:sx r            |
# line "Beat"     | sx>:C5 sxr  sx:B3 sxr  sx sx:C4  | sx>:C5 sxr     sx:B3 sx     sx sx:C6 |
  line "Beat"     | C6:sx> r  B3 r  / r              | C5> r     r:e           C8:sx r      |
