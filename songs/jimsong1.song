# ALL NT
# NT Preset Nov7

song "Nov7 General Testing"

track "Clock"
  type clock_and_transport

track "Harmony"
  type poly_voice
  clef grand
  lead

track "Beat"
  type mono_voice
  clef treble

track "Bass"
  type mono_voice
  clef bass

section "Gate test"  repeat 300
  key C major  meter 3/8  tempo 180 beats/min
  line "Harmony"  | I:e / V7                         | IV           iidim:sx  r        ii:e         | 
  line "Bass"     | C2:sx G2 E2:e r:sx C4            | F2 A3    B3:e         B2:sx r            |
# line "Beat"     | sx>:C5 sxr  sx:B3 sxr  sx sx:C4  | sx>:C5 sxr     sx:B3 sx     sx sx:C6 |
  line "Beat"     | C6:sx> r  B3 r  / r              | C5> r     r:e           C8:sx r      |
