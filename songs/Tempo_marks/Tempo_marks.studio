# Studio for Tempo_marks.song. Port names are the names of the program's MIDI
# output ports; connecting them to devices is done outside (the MIDI router,
# aconnect).
studio "Tempo marks studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"

track "Clock"
  port "Clock"

track "Beat"
  port "Beat pulse"  channel 15
  velocity mezzo_forte 80  accent 127

track "Keys"
  port "Harmony"  channel 1
  velocity mezzo_forte 70  accent 105  marcato 120

track "Bass"
  port "Bass"  channel 2
  octave_offset -2 octaves
  velocity mezzo_forte 100  accent 115
  retrigger_gap 2 ms
