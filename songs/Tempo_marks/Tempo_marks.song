# Tempo marks sample for the Live Lead Sheet. A tempo mark at the start of a
# bar of the lead track's first line changes the tempo from that bar; a ramp
# moves the tempo smoothly over some bars and then holds it.
#
# To hear it:
#   cargo run --release -p song_text --example song_play_test -- \
#     songs/Tempo_marks/Tempo_marks.song songs/Tempo_marks/Tempo_marks.studio
song "Tempo marks"

track "Clock"
  type clock_and_transport

track "Beat"
  type mono_voice
  clef treble

track "Keys"
  type poly_voice
  clef grand
  lead

track "Bass"
  type mono_voice
  clef bass

# 90 beats/min, then 120 beats/min from bar 5.
section "Steps"
  key C major  meter 4/4  tempo 90 beats/min
  line "Keys"  | I:w | IV:w | V:w | I:w | tempo 120 beats/min I:w | IV:w | V:w | I:w |
  line "Bass"  | C2:q / / / | F2:q / / / | G2:q / / / | C2:q / / / | C2:q / / / | F2:q / / / | G2:q / / / | C2:q / / / |

# Writes no tempo: carries on at 120 beats/min.
section "Carried"
  line "Keys"  | IV:w | V:w | I:w | I:w |
  line "Bass"  | F2:q / / / | G2:q / / / | C2:q / / / | C2:q / / / |

# Slows from 120 to 60 beats/min over the two bars of the ramp, then holds 60.
section "Slowing"
  line "Keys"  | tempo 120 ramp_to 60 beats/min 2_bars I:w | IV:w | V:w | I:w |
  line "Bass"  | C2:q / / / | F2:q / / / | G2:q / / / | C2:q / / / |

# Each play starts at 100 beats/min and drops to 80 beats/min in bar 3.
section "Again"  repeat 2
  tempo 100 beats/min
  line "Keys"  | I:w | IV:w | tempo 80 beats/min V:w | I:w |
  line "Bass"  | C2:q / / / | F2:q / / / | G2:q / / / | C2:q / / / |
