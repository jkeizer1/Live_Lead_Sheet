# Studio for Nov15_features_1_7.song. Port names are the names of the program's
# MIDI output ports; connect them to devices outside (the MIDI router, aconnect).
studio "Nov 15 features studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"

track "Clock"
  port "Clock"

track "Keys"
  port "Harmony"  channel 1
  velocity normal 64  accent 100

track "Bass"
  port "Bass"  channel 2
  velocity normal 90  accent 115

track "Beat"
  port "Beat pulse"  channel 15
  velocity normal 90  accent 115
