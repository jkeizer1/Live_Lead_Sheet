# Demo studio: where the tracks of Demo.song go. Port names are the names
# of the program's MIDI output ports; connecting them to devices is done
# outside (the MIDI router, aconnect).
studio "jimssong2.studio"

port "ClockP"
port "HarmonyP"
port "BassP"
port "BeatP"

track "Clock"
  port "ClockP"

track "Harmony"
  port "HarmonyP"  channel 1
  octave_offset -2 octaves
  velocity normal 40  accent 50  marcato 20
  retrigger_gap 50 ms

track "Bass"
  port "BassP"  channel 3
  octave_offset  1 octaves
  velocity normal 90  accent 115
  retrigger_gap 2 ms

track "Beat"
  port "BeatP"  channel 2
  velocity normal 115  accent 127
  octave_offset 0 octaves




