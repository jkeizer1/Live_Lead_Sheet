# ALL NT
# NT Nov12_Song_PlayTest
# Router Nov12
# FH-2 Nov12_Song
# Note Launch Ctl sets volume for the 3 tracks
# cargo run --release -p song_text --example song_play_test -- songs/jims_legato.song songs/jims_legato.studio

song "Nov 12 General Testing"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef treble

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

track "Cymbol"
  type mono_voice
  notes pitched
  clef treble

song_composition
  key C major  meter 4/4  tempo 80 beats/min
  "Count-in"
  "Bass 1"  repeat 12
song_composition_close

section "Count-in"  count-in
  meter 4/4  tempo 80 beats/min
  line "Beat" | B3:q>> B3:q< B3:q< B3:q<< |  

section "Bass 1"  meter 4/4
  key C major
  line "Keys"                   | ii:w                  | IV:w                  |  r:w                | ii:w                     | I:w                   | r:w                   | I:w                   |
  line "Bass"  tonic_octave 2 sample_source     | M2 M3 P4 P5           |  M2 M3 P4 P5 M6       |  M2 M3 P4 P5        | M2 M3 P4 P5 M6 M14        | P8 M3 P5 M2 M3        | P8 M3 P5 M2 M3        | P8 M3 P5 M2 M10 M9 P19  |                  
  line "Bass"                   | :q :q :q :q           | :q :q :q :q           | :q :q :q :q         | :q :q :q :q              | :h :h                 | :h :h                 | :h :h                 |  
  line "Beat"                   | B3:q G2:q G2:q G2:q   | B3:q G2:q G2:q G2:q   | B3:q G2:q G2:q G2:q | B3:q G2:q G2:q G2:q      |  B3:q G2:q G2:q G2:q  | B3:q G2:q G2:q G2:q   | B3:q G2:q G2:q r:q    |
  line "Cymbol"  tonic_octave 2                 | r:q P1:q r:q P1:q     | r:q P1:q r:q P1:q     | r:q P1:q r:q P1:    | r:q P1:q r:q P1:q        | r:q P1:q r:q P1:q     | r:q P1:q r:q P1:q     | r:q P1:q r:q P1:q     |
 

