# Test studio, owned by the tests, for song_test_count_in_and_verse.song.
# Do not edit for music; change it only together with those tests.
studio "Song test studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"
port "To SQ-1"

track "Clock"
  port "Clock"

track "Beat"
  port "Beat pulse"  channel 15
  velocity normal 80  accent 127

track "Keys"
  port "Harmony"  channel 1
  velocity normal 70  accent 105  marcato 120

track "Bass"
  port "Bass"  channel 2
  octave_offset -1 octaves
  velocity normal 100  accent 115
  retrigger_gap 2 ms

destination "SQ-1"
  port "To SQ-1"  channel 1
