# Demo song for the Live Lead Sheet: a two-bar count-in, then a two-bar
# verse that plays twice. It names no port, channel or device; Demo.studio
# says where each track goes.
# Tossed 24 Nov 2026 (line 16): jim was here
song "Demo"

track "Clock"
  type clock_and_transport

track "Beat"

  type mono_voice
  notes midi_note
  clef treble

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead 

track "Bass"
  type mono_voice
  notes pitched
  clef bass

#track "Cues"
#  type cue_control
#  cue "Start SQ-1"  destination "SQ-1"  start

song_composition
  key C major  meter 4/4  tempo 140 beats/min
  "Count-in"
  "Verse ONE"
  "Verse TWO"  repeat 2
  "Verse THREE"
  "Verse CLOSE"  repeat 2
song_composition_close

section "Count-in"  count-in
  meter 4/4  tempo 140 beats/min
  line "Beat"  | C4:q> / / / |

# C – G – Am – F
section "Verse ONE"
  key C major  meter 4/4  tempo 140 beats/min
  line "Keys"  sample_source    | I IV V ii IV V vii | V V IV IV I I | I IV V ii IV V vii | V V IV IV I I |
  line "Keys"  tonic_octave 2                   | :h :q :q | :q :q :e :e :e :e | :q :e :e :q :e :e | trp(P1:e P8:e P15:e) :sx :sx :sx r:sx :q r:q|
  line "Bass"  tonic_octave 2  | trp(M6:q> M6:q M6:q) trp(M6:q M6:q M7:q) | P5:q / P1 / | M3 / /:h | P1:q> / /> /:e / |
  line "Beat"  | C4:q> / /> /           | / / / /             | C4 / / /       | / / / / |

# G – Am
section "Verse TWO"
  key C major  meter 4/4  tempo 140 beats/min

#                G                        Am
  line "Keys"  sample_source  | V V V V V V V V | vi vi |
  line "Keys"                  | :q.> :e r:h | :h>> :h |
  line "Bass"  tonic_octave 3  | -P4:h  -m2               | -m3  /               |
  line "Beat"  | C4:q> / /> /           | / / / /             |

section "Verse THREE"
  key C major  meter 4/4  tempo 140 beats/min
#                Baug                    Dm                 
  line "Keys"  | vii°:h /               | ii  /               | 
  line "Bass"  tonic_octave 2  | M7:q.> /:e r:h | M2 M9 |
  line "Beat"  | C4:q> / /> /           | / / / /             |

section "Verse CLOSE"
  key C major  meter 4/4  tempo 140 beats/min
#                Baug                    Dm                 
  line "Keys"  | vii°:h /               | ii  /               | 
  line "Bass"  tonic_octave 2  | M7:q.> /:e r:h | M2 M9 |
  line "Beat"  | C4:q> / /> /           | / / / /             |

