# Demo song for the Live Lead Sheet: a two-bar count-in, then a two-bar
# verse that plays twice. It names no port, channel or device; Demo.studio
# says where each track goes.
song "Demo"

track "Clock"
  type clock_and_transport

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass


# C – G – Am – F
song_composition
  key C major  meter 4/4  tempo 140 beats/min
  "Verse"
song_composition_close

section "Verse"
  key C major  meter 4/4  tempo 140 beats/min
  line "Keys"  tonic_octave 4  | I:h /                  | V  /                |  vi /          | -m2:w       |
  line "Beat"  | C4:q< / / / | C4:q<< / / / | C4:q / / / | C4:q> / / / |

