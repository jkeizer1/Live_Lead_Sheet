# Test: a new song. Song settings (F6) manages its tracks and its studio.
song "Test"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

song_composition
  key C major  meter 4/4  tempo 120 beats/min
  "Section"
song_composition_close

section "Section"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | r:w |
