# ALL NT
# NT Preset Nov7
# Router Nov7

song "Nov7 General Testing"

track "Clock"
  type clock_and_transport

track "Harmony"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

track "Bass"
  type mono_voice
  notes pitched
  clef bass

song_composition
  key C major  meter 3/8  tempo 100 beats/min
  "Count-in"  repeat 2
  "Gate test"  repeat 300
song_composition_close

section "Count-in"  count-in
  meter 3/8  tempo 100 beats/min
  line "Beat"  | C5:e>  C2 /   |

section "Gate test"
  key C major  meter 3/8  tempo 100 beats/min
#                  Phrase 1                                                                                         
