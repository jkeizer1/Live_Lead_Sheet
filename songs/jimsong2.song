# ALL NT
# NT Preset Nov7
# Router Nov7

song "Nov7 General Testing"

track "Clock"
  type clock_and_transport

track "Harmony"
  type poly_voice
  clef grand
  lead

track "Beat"
  type mono_voice
  clef treble

track "Bass"
  type mono_voice
  clef bass

section "Count-in"  count-in repeat 2
  meter 3/8  tempo 100 beats/min
  line "Beat"  | C5:e>  C2 /   |

section "Gate test"  repeat 300
  key C major  meter 3/8  tempo 100 beats/min
#                  Phrase 1                                                                                         
  line "Harmony"  | I:q.            | IV:e   /   IV      |  vii°:q  /:e                         |
                  | I:e. V          | IV:e       IV:q    |  vii°  /:e                         |
                  | I:e. V          | IV7     IV         |  vii°:q  /:e                         |    
        
  line "Bass"     | C2:e> E2 G2     | F2>  A2  C3        |  G2    D2 B2                        |
                  | C2> E2 G2       | F1>  A2  C3        |  G3    D2 B2                        |
                  | C2> E2 G2       | F1>  A2  C4        |  G2    D2 B2                        |

  line "Beat"     | C6:e> B3 /      | F6> A3 C2          |  C6:sx r C5> r C4 C5                | 
                  | C6:e> B3 /      | C6> B3 C2          |  C6:sx r C5> r C4 C5                |
                  | C6:e> B3 /      | C6> B3 C2          |  C6:sx r C5> r C4 C5                |

