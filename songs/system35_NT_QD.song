# System35 legato and general test
# cargo run --release -p song_text --example song_play_test -- songs/system35_NT_QD.song songs/system35_NT_QD.studio

song "System35 Testing"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

track "VPME_Blue"
  type mono_voice
  notes pitched
  clef bass

track "MCO_SID"
  type mono_voice
  notes pitched
  clef bass

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "tune"  repeat 2
  "unison"  repeat 2
  "1"  repeat 2
  "2"  repeat 2
  "3"  repeat 4
  "4"  repeat 2
  "5"  repeat 4
song_composition_close

section "tune"
  key C major
  meter 4/4  tempo 100 beats/min
  line "Bass"  tonic_octave 1     | M2:w |

section "unison"  meter 4/4  key C major
  line "Bass"  tonic_octave 2                    | M2:w  |

  line "MCO_SID"  tonic_octave 2 sample_source   | M2    |
  line "MCO_SID"                 | :w    |
                   

section "1"  meter 4/4  key C major
    
  line "Bass"  tonic_octave 1                    | M9:e_ M13:e_ P11:e_ M9:e  M13:e_ P12:e_ P11:e  r:e  | P8:h_  M10:h           | M9:e  M13:e  P11:e  M9:e  M13:e  r:e   M20:e  r:e       | P8:h_   M2:h  |  

  line "VPME_Blue"  tonic_octave 1 sample_source | M2                                             | P1                    | M2                                                  | P1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID"  tonic_octave 1 sample_source   |  M2                                            |  P1                   | M2                                                  | P1 P12 M2 M13   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                  
                   

section "2"  meter 4/4  key C major
    
  line "Bass"  tonic_octave 1                    | P11:e_ M13:e_ P11:e_ P8:e  M13:e_ P8:e_ P11:e  r:e  | P8:h_  P12:h           | M21:e  P5:e  M10:e  P5:e_  M21:e  r:e   M14:e  r:e      | P8:h_   M2:h  |  

  line "VPME_Blue"  tonic_octave 1 sample_source | P4                                             | P1                    | M7                                                  | P1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID"  tonic_octave 1 sample_source   | P4                                             |  P1                   | M7                                                  | P1 P12 M2 M13   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                     

section "3"  meter 4/4  key C major
    
  line "Bass"  tonic_octave 1                    | M9:e_ M13:e_ P11:e_ M9:e  M13:e_ P12:e_ P11:e  r:e  | P8:h_  M10:h           | M9:e  M13:e  P11:e  M9:e  M13:e  r:e   M20:e  r:e       | P8:h_   M2:h  |  

  line "VPME_Blue"  tonic_octave 1 sample_source | M2                                             | P1                    | M2                                                  | P1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID"  tonic_octave 1 sample_source   |  M2                                            |  P1                   | M2                                                  | P1 P12 M2 M13   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |   

section "4"  meter 4/4  key C major
    
  line "Bass"  tonic_octave 1                    | P11:e_ M13:e_ P11:e_ P8:e  M13:e_ P8:e_ P11:e  r:e  | P8:h_  P12:h           | M21:e_  P5:e  M10:e  P5:e_  M21:e  r:e   M14:e  r:e     | P8:h_   M2:h  |  

  line "VPME_Blue"  tonic_octave 1 sample_source | P4                                             | P1                    | M7                                                  | P1            |
  line "VPME_Blue"               | :q :q :q :q                                    | :q :q :q :q           | :q :q :q :q                                         | :q :q :q :q   |

  line "MCO_SID"  tonic_octave 1 sample_source   | P4                                            |  P1                    | M7                                                  | P1 P12 M2 M13   |
  line "MCO_SID"                 | :h   :h                                        | :h :h                 | :h :h                                               | :w            |                     

section "5"  meter 4/4  key C major
    
  line "Bass"  tonic_octave 1                    | M9:e_ M13:e_ P11:e_ M9:e  M13:e_ P12:e_ P11:e  r:e  | P8:h_  M10:h           | M9:e  M13:e  P11:e  M9:e  M13:e  r:e   M20:e  r:e       | P8:h_   M2:h  |  

  line "VPME_Blue"  tonic_octave 1 sample_source | M2                                             | P1                    | M2                                                  | P1            |
