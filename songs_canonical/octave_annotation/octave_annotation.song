# Canonical test song: crates/song_text/tests/octave_annotation_plan.rs reads this file and expects exactly this content.
# Octave annotations: +8va and -8va at the start of a bar stay in effect until changed; loco returns to the clef's octave.
# To hear it:
#   cargo run --release -p song_text --example song_play_test -- \
#     songs_canonical/octave_annotation/octave_annotation.song songs_canonical/octave_annotation/octave_annotation.studio
song "Octave annotation cases"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

section "octaves"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  tonic_octave 4  | P1:w | +8va P1:w | P1:w | -8va P1:w | loco P1:w | I:w | +8va I:w | +8va P1:w | +8va P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "octaves"
song_composition_close
