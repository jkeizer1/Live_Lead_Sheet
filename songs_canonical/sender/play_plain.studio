# crates/sender, src/commanded_play_tests.rs: every test that plays a whole song.
# The studio for play_plain.song: one port per track, a retrigger gap of 18 ms on the bass, no delay_trigger.
studio "Sender test studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"

track "Clock"
  port "Clock"

track "Beat"
  port "Beat pulse"  channel 15
  velocity mezzo_forte 80  accent 127

track "Keys"
  port "Harmony"  channel 1

track "Bass"
  port "Bass"  channel 2
  velocity mezzo_forte 100  accent 115
  retrigger_gap 18 ms
