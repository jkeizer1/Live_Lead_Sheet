# crates/sender, src/commanded_play_tests.rs: the test that plays to the natural end with a delay_trigger.
# The studio for play_plain.song with the bass delayed 20 ms, so the last event is sent after its instant.
studio "Sender test studio, delayed bass"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"

track "Clock"
  port "Clock"

track "Beat"
  port "Beat pulse"  channel 15
  velocity mezzo_forte 80  accent 127

track "Keys"
  port "Harmony"  channel 1

track "Bass"
  port "Bass"  channel 2
  velocity mezzo_forte 100  accent 115
  retrigger_gap 18 ms
  delay_trigger 20 ms
