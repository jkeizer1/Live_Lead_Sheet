# Canonical test song: crates/song_text/tests/dynamics_plan.rs (the within_bar tests) reads this file and expects exactly this content.
# Dynamics inside one bar: a ramp that fills the bar between two levels, a ramp between two lengths, a sudden jump, and a diminuendo that fills what is left.
# To hear it:
#   cargo run --release -p song_text --example song_play_test -- \
#     songs_canonical/dynamics/dynamics_within_bar.song songs_canonical/dynamics/dynamics.studio
song "Dynamics within a bar"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  lead

section "pp to ff over the bar, then ff holds"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:q D4 E4 F4 | C4:w |
  line "Keys"  dynamics  | pp < ff | ff:w |

section "pp, a crescendo over a half note, ff"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:q D4 E4 F4 |
  line "Keys"  dynamics  | pp:q < ff:q |

section "pp then ff with no ramp"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:q D4 E4 F4 |
  line "Keys"  dynamics  | pp:h ff:h |

section "ff, a diminuendo that fills the bar, pp on the last beat"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:q D4 E4 F4 |
  line "Keys"  dynamics  | ff > pp:q |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "pp to ff over the bar, then ff holds"
  "pp, a crescendo over a half note, ff"
  "pp then ff with no ramp"
  "ff, a diminuendo that fills the bar, pp on the last beat"
song_composition_close
