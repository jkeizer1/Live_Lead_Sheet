# Canonical test song: crates/song_text/tests/dynamics_plan.rs reads this file.
# A crescendo with no level after it: the loader must refuse it and say to write the target level.
song "Dynamics ramp without target"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  lead

section "ramp"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:w | / |
  line "Keys"  dynamics  | p:w | <:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "ramp"
song_composition_close
