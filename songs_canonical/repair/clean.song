# crates/composer/src/repair.rs, tests in that file: a_clean_pair_has_no_problems.
# A valid song, read together with clean.studio.
song "Repair test"

track "Clock"
  type clock_and_transport

track "Beat"
  type mono_voice
  clef treble
  lead

section "Verse"
  key C major  meter 4/4  tempo 120 beats/min
  line "Beat"  | C4:q> / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Verse"
song_composition_close
