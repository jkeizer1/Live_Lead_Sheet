# Canonical test song, deliberately wrong: crates/song_text/tests/sample_source_plan.rs
# loads it and expects the loader to refuse it with one message.
# The mistake: A chord with no length on an ordinary line (no sample_source).
song "Sample source cases"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  lead

section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" | I IV V I |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
