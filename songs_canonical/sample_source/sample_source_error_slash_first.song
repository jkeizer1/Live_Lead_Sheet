# Canonical test song: crates/song_text/tests/sample_source_plan.rs, test `a_slash_first_on_a_rhythm_line_is_refused`.
# The loader must refuse it: the / has nothing before it to play again, and the message says to write :q to take it from the source.
song "Sample source slash first"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Bass"  tonic_octave 2 sample_source | M2 M6 P4 M2 |
  line "Bass"               | /:q :q :q :q |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
