# Canonical test song: crates/song_text/tests/sample_source_plan.rs reads this
# file and expects exactly this content. Change a copy in songs/, not this file.
# Sample source: the chords and bass notes are written on their own lines,
# the rhythm on the lines below. Each rhythm element plays what its source
# holds when it starts, and follows the source if it changes while it sounds.
# Play it with the Demo studio:
#   cargo run --release -p song_text --example song_play_test -- \
#     songs_canonical/sample_source/sample_source.song songs_canonical/sample_source/sample_source.studio
song "Sample source"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass

section "Chords and bass from sources"
  key C major  meter 4/4  tempo 120 beats/min
  # Bar 2 shares its bar between IV, IV and V (a third of a bar each), so the
  # half note on beat 3 starts on the second IV and moves to V.
  line "Keys"  sample_source  | I | IV IV V | vi | V |
  line "Keys"                 | :h :q :q | :h :h | :q :q :q :q | :w |
  line "Bass"  tonic_octave 2  sample_source  | P1 | P4 P4 P5 | M6 | P5 |
  line "Bass"                 | :q :q :q :q | :q :q :q :q | :h :h | :q r :h |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Chords and bass from sources"  repeat 2
song_composition_close
