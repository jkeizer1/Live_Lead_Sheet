# Canonical test song: crates/song_text/tests/tempo_marks_plan.rs reads this file and expects exactly this content.
# Tempo marks on the lead line: a step, a section after it that plays at the composition's tempo (a section's marks do not pass on), a ramp that holds, and a repeated section that restarts at its own tempo.
# To hear it:
#   cargo run --release -p song_text --example song_play_test -- \
#     songs_canonical/tempo_marks/tempo_marks.song songs_canonical/tempo_marks/tempo_marks.studio
song "Tempo mark cases"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  lead

track "Bass"
  type mono_voice
  clef bass

section "Steps"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w | I:w | tempo 120 beats/min IV:w | IV:w |
  line "Bass"  | C2:q / / / | C2:q / / / | F2:q / / / | F2:q / / / |

section "Carried"  meter 4/4
  line "Keys"  | V:w | I:w |
  line "Bass"  | G2:q / / / | C2:q / / / |

section "Ramp"  meter 4/4
  tempo 120 beats/min
  line "Keys"  | I:w | tempo 120 ramp_to 60 beats/min 2_bars IV:w | V:w | I:w |
  line "Bass"  | C2:q / / / | F2:q / / / | G2:q / / / | C2:q / / / |

section "Again"  meter 4/4
  tempo 100 beats/min
  line "Keys"  | I:w | tempo 80 beats/min V:w |
  line "Bass"  | C2:q / / / | G2:q / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Steps"
  "Carried"
  "Ramp"
  "Again"  repeat 2
song_composition_close
