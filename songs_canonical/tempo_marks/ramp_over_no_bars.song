# Canonical test song (deliberately wrong): crates/song_text/tests/tempo_marks_plan.rs, test `ramp_over_no_bars`.
# A ramp over 0_bars. The loader must refuse it: a ramp that takes no bars never moves.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | tempo 100 ramp_to 120 beats/min 0_bars I:w | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
