# Canonical test song (deliberately wrong): crates/song_text/tests/tempo_marks_plan.rs, test `two_marks_in_a_bar`.
# Two tempo marks in one bar. The loader must refuse it: a bar holds one mark.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | tempo 90 beats/min tempo 80 beats/min I:w | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
