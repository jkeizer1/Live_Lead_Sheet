# Canonical test song (deliberately wrong): crates/song_text/tests/tempo_marks_plan.rs, test `mark_inside_ramp`.
# A tempo mark in a bar a ramp covers. The loader must refuse it: bar 2 is inside the 2_bars ramp that starts in bar 1.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | tempo 100 ramp_to 120 beats/min 2_bars I:w | tempo 90 beats/min I:w | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
