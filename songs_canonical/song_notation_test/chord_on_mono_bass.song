# Canonical test song (deliberately wrong): crates/song_text/examples/song_notation_test/main.rs, case "a chord on the mono bass".
# The loader must refuse it with one message: a mono voice plays one note at a time.
song "T"
track "Clock"
 type clock_and_transport
track "Keys"
 type poly_voice
 notes pitched
 clef grand
 lead
track "Bass"
 type mono_voice
 notes pitched
 clef bass
section "A"
 key C major  meter 4/4  tempo 120 beats/min
 line "Bass"  tonic_octave 2 | P1:q / / V7 |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
