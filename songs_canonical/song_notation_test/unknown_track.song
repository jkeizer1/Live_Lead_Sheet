# Canonical test song (deliberately wrong): crates/song_text/examples/song_notation_test/main.rs, case "a line for a track the song does not have".
# The loader must refuse it with one message: "Drums" is not a track of the song.
song "T"
track "Clock"
 type clock_and_transport
section "A"
 meter 4/4  tempo 120 beats/min
 line "Drums" | C4:q D4 E4 F4 |
