# Canonical test song (deliberately wrong): crates/song_text/examples/song_notation_test/main.rs, case "a chord the notation does not know".
# The loader must refuse it with one message: IV9b is not a chord.
song "T"
track "Clock"
 type clock_and_transport
track "Keys"
 type poly_voice
 clef grand
 lead
section "A"
 key C major  meter 4/4  tempo 120 beats/min
 line "Keys" | IV9b:q / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
