# Canonical test song (deliberately wrong): crates/song_text/examples/song_notation_test/main.rs, case "a first note with no length".
# The loader must refuse it with one message: nothing gives the first chord a length.
song "T"
track "Clock"
 type clock_and_transport
track "Keys"
 type poly_voice
 notes pitched
 clef grand
 lead
section "A"
 key C major  meter 4/4  tempo 120 beats/min
 line "Keys" | I / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
