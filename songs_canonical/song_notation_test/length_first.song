# Canonical test song (deliberately wrong): crates/song_text/examples/song_notation_test/main.rs, case "a line in the old order, length first".
# The loader must refuse it with one message: a song line writes what it plays first, then its length.
song "T"
track "Clock"
 type clock_and_transport
track "Keys"
 type poly_voice
 notes pitched
 clef grand
 lead
section "A"
 key C major  meter 4/4  tempo 120 beats/min
 line "Keys" | q:I q q q |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
