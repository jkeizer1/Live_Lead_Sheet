# Canonical test song (valid): crates/lilypond_export/src/score.rs, test `voice_layers`.
# Three voice layers on the Manual; layers 1 and 2 share the upper staff, layer 3 lies below middle C.
song "T"
track "Clock"
  type clock_and_transport
track "Manual"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
track "Cues"
  type cue_control
  cue "Go" destination "X" start
section "A"
  key C major  meter 4/4  tempo 60 beats/min
  line "Manual"  voice_layer 1  tonic_octave 4  | P5:h P4 |
  line "Manual"  voice_layer 2  tonic_octave 4  | m3:q M2 P1 M2 |
  line "Manual"  voice_layer 3  tonic_octave 3  | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
