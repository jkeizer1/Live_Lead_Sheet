# Canonical test song (valid): crates/lilypond_export/src/score.rs, test `triplets_marks_ties_slurs_cues`.
# A triplet, a slurred note, a tie, a fermata and a cue.
song "T"
track "Clock"
  type clock_and_transport
track "Manual"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
track "Cues"
  type cue_control
  cue "Go" destination "X" start
section "A"
  key C major  meter 4/4  tempo 60 beats/min
  line "Bass"  | trp (C2:q D2 E2) F2:q_ G2~ | G2:w^ |
  line "Cues"  | "Go":h r | r:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
