# Read by crates/composer (session.rs, arrange_tests::f1_edits_write_the_song_composition): the text F1 writes after its key series.
# arrange_song.song after: Intro repeat 3, start key D major, Riff entry key cleared, Riff tempo 112.5, change tempo 121, Bridge renamed, new Outro.
song "Arrange song"
chord_numeral_standard key_dependent

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef treble
  lead

track "Bass"
  type mono_voice
  clef bass

song_composition
  key D major  meter 4/4  tempo 100 beats/min
  "Intro"  repeat 3
  "Riff"  tempo 112.5 beats/min
  key E minor  tempo 121 beats/min
  "Riff"
  "Bridge B"
  "Outro"
song_composition_close

section "Intro"
  meter 4/4
  line "Keys"  | I:w | V:w |

section "Riff"
  meter 4/4
  line "Keys"  | I:h IV | V:w |
  line "Bass"  | G2:h C2 | D2:w |

section "Bridge B"
  meter 3/4  key C major  tempo 90 beats/min
  line "Keys"  | ii7:h. | V7:h. |

section "Outro"
  meter 3/4  key G major  tempo 80 beats/min
  line "Keys"  | r:h. |
