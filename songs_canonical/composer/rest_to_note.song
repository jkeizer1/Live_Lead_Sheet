# Read by crates/composer (session.rs, test a_rest_becomes_the_chords_root_and_back).
# A bass rest on beat 3 of a C bar, and a keys rest on beat 3 of a G bar, to turn into notes.
song "Rest to note"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef treble
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass

song_composition
  key C major  meter 4/4  tempo 120 beats/min
  "Verse"
song_composition_close

section "Verse"  key C major
  meter 4/4
  line "Keys"  | I:w | V:h r |
  line "Bass"  tonic_octave 2  | P1:h r:q P5 | P5:w |
