# Read by crates/composer (song_source, edits, timeline, session tests) and by the editor's layout preview.
# A small song with a count-in, a coupled verse, a chorus reused in D major, and an uncoupled bridge.
song "Composer demo"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef treble
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

song_composition
  key C major  meter 4/4  tempo 120 beats/min
  "Count-in"
  "Verse"  repeat 2
  "Chorus"  key D major
  "Bridge"
  "Verse"
song_composition_close

section "Count-in"  count-in
  meter 4/4  tempo 120 beats/min
  line "Beat"  | C4:q> / / / |

# I – vi – ii – V
section "Verse"  key C major
  meter 4/4
  line "Keys"  | I:h / | vi:q / / / |
               | ii7:h / | V7:q / / / |
  line "Bass"  tonic_octave 2  | P1:h P5 | M6:q M3 M6 M3 | M2:h M6 | P5:q M2 P5 M7 |
  line "Beat"  | C4:q> / / / | /> / / / | /> / / / | /> / / / |

section "Chorus"  key C major
  meter 4/4
  line "Keys"  | IV:q. I:e~ I:h | V:q. vi:e~ vi:h |
  line "Bass"  tonic_octave 2  | P4:q. P1:e~ P1:h | P5:q. M6:e~ M6:h |
  line "Beat"  | C4:q> / / / | /> / / / |

section "Bridge"  key C major
  meter 4/4
  line "Keys"  sample_source  | vi | IV V |
  line "Keys"                 | :q. :e~ :h | :q :q :q :q |
  line "Bass"  tonic_octave 2  | M6:w | P4:h P5 |
  line "Beat"  | C4:q> / / / | /> / / / |
