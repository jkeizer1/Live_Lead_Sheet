# Canonical test song: crates/song_text/tests/minor_key.rs reads this file and expects exactly this content.
# A song in C minor and then A minor whose parts are notes: it loads and plans; each section's key is a minor key.
song "Minor key notes"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead

track "Bass"
  type mono_voice
  notes pitched
  clef bass

section "C minor"
  key C minor  meter 4/4  tempo 100 beats/min
  line "Keys"  tonic_octave 4  | P1:w | -P4:w |
  line "Bass"  tonic_octave 2  | P1:q / / / | -P4:q / / / |

section "A minor"  meter 4/4
  key A minor
  line "Keys"  tonic_octave 3  | P1:w | -P4:w |
  line "Bass"  tonic_octave 1  | P1:q / / / | -P4:q / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "C minor"
  "A minor"
song_composition_close
