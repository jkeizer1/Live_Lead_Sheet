# Canonical test song (deliberately wrong): crates/song_text/tests/minor_key.rs, test `a_second_standard_line_is_refused`.
# Two chord_numeral_standard lines. The loader must refuse the second: a song has one.
song "T"
chord_numeral_standard key_dependent
chord_numeral_standard major_referential
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C minor  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:w |
