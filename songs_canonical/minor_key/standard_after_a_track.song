# Canonical test song (deliberately wrong): crates/song_text/tests/minor_key.rs, test `the_standard_goes_before_the_first_track`.
# chord_numeral_standard written after a track. The loader must refuse it: it belongs on the line after song.
song "T"
track "Clock"
  type clock_and_transport
chord_numeral_standard key_dependent
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C minor  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
