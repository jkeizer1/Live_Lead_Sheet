# Canonical test song (deliberately wrong): crates/song_text/tests/meter_control_plan.rs, test `bar_not_the_bars_meter`.
# Bar 2 is 5/4 by the pattern but the Keys line writes only a whole note in it. The loader must refuse it, naming bar 2 as 5/4 and short by a quarter note.
song "T"
track "Clock"
  type clock_and_transport
track "Meter"
  type meter_control
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  tempo 100 beats/min
  line "Meter"  | mp [3_4 5_4] |
  line "Keys"  | I:h. | IV:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
