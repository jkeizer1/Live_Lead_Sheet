# Canonical test song (deliberately wrong): crates/song_text/tests/meter_control_plan.rs, test `meter_and_pattern`.
# A section that writes a meter and also has a meter_control line. The loader must refuse it: a section has one or the other.
song "T"
track "Clock"
  type clock_and_transport
track "Meter"
  type meter_control
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Meter"  | mp [3_4 5_4] |
  line "Keys"  | I:h. | IV:w IV:q |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
