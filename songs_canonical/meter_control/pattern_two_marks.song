# Canonical test song (deliberately wrong): crates/song_text/tests/meter_control_plan.rs, test `pattern_two_marks`.
# The meter_control line holds two mp marks. The loader must refuse it: one mp mark, which repeats to the end of the section by itself.
song "T"
track "Clock"
  type clock_and_transport
track "Meter"
  type meter_control
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  tempo 100 beats/min
  line "Meter"  | mp [3_4] | mp [5_4] |
  line "Keys"  | I:h. | IV:h. |
