# Canonical test song (deliberately wrong): crates/song_text/tests/meter_control_plan.rs, test `tempo_control_track`.
# A track of type tempo_control. The loader must refuse it: tempo changes are marks on the lead line.
song "T"
track "Clock"
  type clock_and_transport
track "Tempo"
  type tempo_control
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
