# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `bars_before_any_line`.
# Bars before any line in the section. The loader must refuse it: bars with no line above them.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  | I:w |

song_composition
