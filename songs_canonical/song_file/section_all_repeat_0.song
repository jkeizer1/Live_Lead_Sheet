# Canonical test song: crates/song_text/src/song_file.rs, test `a_song_whose_sections_all_have_repeat_0_is_refused`.
# The loader must refuse it: nothing would play.
song "All repeat 0"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Bass"  tonic_octave 2 | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"  repeat 0
song_composition_close
