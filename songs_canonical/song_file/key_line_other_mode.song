# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_key_line_of_the_other_mode_is_refused_at_the_entry`.
# A key line sets E minor above the second "Riff", which is in C major. The loader must refuse it at that entry (line 21) and say to write key section or a major key.
song "Key line mode"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "Riff"  key C major  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
  key E minor
  "Riff"
song_composition_close
