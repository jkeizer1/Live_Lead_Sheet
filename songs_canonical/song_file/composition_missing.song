# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_song_without_a_composition_is_refused`.
# Sections but no song_composition. The loader must refuse it and say to list the sections in a song_composition.
song "No composition"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "Riff"
  key C major  meter 4/4  tempo 100 beats/min
  line "Bass" | C2:w |
