# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `voice_layer_1_twice`.
# A Keys line with no voice layer (layer 1) and another that says voice_layer 1. The loader must refuse it: two lines for one layer.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:w |
  line "Keys"  voice_layer 1  | V:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
