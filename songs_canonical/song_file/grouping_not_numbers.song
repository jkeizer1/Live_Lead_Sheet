# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `grouping_not_numbers`.
# grouping 2+x is not numbers. The loader must refuse it at the line with the settings (line 12), saying how to write a grouping.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
section "A"
  key C major  meter 7/8  grouping 2+x  tempo 120 beats/min
  line "Keys" | I:h. r:e |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
