# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_section_with_a_repeat_is_refused`.
# Section "A" carries repeat 2, the old notation. The loader must refuse it and say to write the repeat on its entry in song_composition.
song "Section with repeat"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "A"  repeat 2  meter 4/4
  line "Bass" | C2:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
