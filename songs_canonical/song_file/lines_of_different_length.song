# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `lines_of_different_length`.
# Keys has one bar, Bass has two. The loader must refuse it: reported at the section.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:q / / / |
  line "Bass"  tonic_octave 2  | P1:q / / / | / / / / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
