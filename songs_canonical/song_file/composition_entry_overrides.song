# Canonical test song: crates/song_text/src/song_file.rs, test `a_composition_entry_may_change_key_and_tempo`.
# One section "Riff" is played three times: as written, in D major at 120 beats/min, then again with no override (it carries D major and 120 on).
song "Entry overrides"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "Riff"
  line "Bass" | C2:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
  "Riff"  key D major  tempo 120 beats/min
  "Riff"
song_composition_close
