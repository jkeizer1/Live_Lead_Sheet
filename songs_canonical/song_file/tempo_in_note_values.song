# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `tempo_in_note_values`.
# Tempo written the old way, 30 e/min. The loader must refuse it: says to write the tempo in beats.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 30 e/min

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
