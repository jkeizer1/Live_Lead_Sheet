# Canonical test song (valid): crates/song_text/src/song_file.rs, test `voice_layers`.
# Keys has three voice layers and Bass has one, each two bars.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  voice_layer 1  tonic_octave 4  | P5:q P5 P4 m3 | P8:w |
  line "Keys"  voice_layer 2  tonic_octave 4  | m3:sx M2 m3:e~ m3:sx P4 m3 M2 P1:e M2~ M2 P1 | P1:w |
  line "Keys"  voice_layer 3  tonic_octave 4
    | r:h -m3~ |
    | -m3 r |
  line "Bass"  tonic_octave 3  | P1:w | / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
