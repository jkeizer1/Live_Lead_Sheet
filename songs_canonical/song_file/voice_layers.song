# Canonical test song (valid): crates/song_text/src/song_file.rs, test `voice_layers`.
# Keys has three voice layers and Bass has one, each two bars.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  voice_layer 1  | G4:q G4 F4 Eb4 | C5:w |
  line "Keys"  voice_layer 2  | Eb4:sx D4 Eb4:e~ Eb4:sx F4 Eb4 D4 C4:e D4~ D4 C4 | C4:w |
  line "Keys"  voice_layer 3
    | r:h A3~ |
    | A3 r |
  line "Bass"  | C3:w | / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
