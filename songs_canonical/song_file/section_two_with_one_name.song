# Canonical test song: crates/song_text/src/song_file.rs, test `two_sections_with_lines_may_not_share_a_name`.
# The loader must refuse the second "A": two sections with lines are named "A"; to play "A" again, write it with no lines.
song "Two with one name"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Bass" | C2:w |

section "A"
  line "Bass" | D2:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
  "A"
song_composition_close
