# Canonical test song (valid): crates/song_text/src/song_file.rs, test `euclid_spreads_hits_over_the_bar`.
# Bass bar 1: euclid(3,8); bar 2: euclid(2,5) with an accent on each hit. Keys: a rhythm line of :euclid(3,8) reading a sample source.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" sample_source | I | I |
  line "Keys" | :euclid(3,8) | :euclid(2,5) |
  line "Bass"  tonic_octave 2 | P1:euclid(3,8) | P1:euclid(2,5)> |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
