# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_section_with_a_pitched_line_needs_its_own_key`.
# "Riff" has a line on a pitched track and no key. The loader must refuse it at the section (line 14): its intervals need the section's tonic.
song "No key"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "Riff"  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
song_composition_close
