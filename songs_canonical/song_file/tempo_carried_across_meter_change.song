# Canonical test song (valid): crates/song_text/src/song_file.rs, test `tempo_carried_across_meter_change`.
# Section B writes no tempo: the quarter note stays at 120 q/min in 6/8.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" | I:w |
section "B"
  meter 6/8
  line "Keys" | I:h. |
