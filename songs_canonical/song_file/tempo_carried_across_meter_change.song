# Canonical test song (valid): crates/song_text/src/song_file.rs, test `tempo_carried_across_meter_change`.
# Sections B to D write no tempo: the beats per minute carry on (4/4 q 120, 3/4 q 120, 6/8 dotted q 120 = q 180, 4/4 q 120).
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" | I:w |
section "B"
  meter 3/4
  line "Keys" | I:h. |
section "C"
  meter 6/8
  line "Keys" | I:h. |
section "D"
  meter 4/4
  line "Keys" | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
  "B"
  "C"
  "D"
song_composition_close
