# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `euclid_beside_another_element_is_refused`.
# euclid shares its bar with another element. The loader must refuse it at line 17: euclid fills the whole bar.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Bass"  tonic_octave 2 | P1:q P1:euclid(3,8) |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
