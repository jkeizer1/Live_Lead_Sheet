# Canonical test song (valid): crates/song_text/src/song_file.rs, test `beat_grouping_is_kept_with_its_meter`.
# 7/8 grouping 2+2+3; the next section carries meter and grouping; 5/4 grouping 3+2; 4/4 writes none.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  meter 7/8  grouping 2+2+3  tempo 120 beats/min
  line "Keys" | I:h. r:e |
section "B"
  line "Keys" | I:h. r:e |
section "C"
  meter 5/4  grouping 3+2
  line "Keys" | I:h. r:h |
section "D"
  meter 4/4
  line "Keys" | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
  "B"
  "C"
  "D"
song_composition_close
