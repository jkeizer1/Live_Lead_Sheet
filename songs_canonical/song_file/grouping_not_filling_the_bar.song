# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `grouping_not_filling_the_bar`.
# 7/8 with grouping 2+2+2 (6 pulses). The loader must refuse it at the section line, saying what to write.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
section "A"
  key C major  meter 7/8  grouping 2+2+2  tempo 120 beats/min
  line "Keys" | I:h. r:e |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
