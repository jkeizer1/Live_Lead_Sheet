# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `key_section_is_only_for_an_entry`.
# "Riff" writes key section, which belongs on a song composition entry. The loader must refuse it at the section (line 14).
song "Key section"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "Riff"  key section  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
song_composition_close
