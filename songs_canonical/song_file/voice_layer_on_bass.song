# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `voice_layer_on_bass`.
# voice_layer 2 on the mono Bass. The loader must refuse it: only layer 1 on a mono voice.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Bass"  voice_layer 2  | C2:w |
