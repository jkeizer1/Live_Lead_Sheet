# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `voice_layer_used_but_not_named`.
# A line for voice_layer 2 of Keys whose track block says voice_layer 2 with no name. The loader must refuse it: asks for voice_layer 2 "Name".
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
  voice_layer 2
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
