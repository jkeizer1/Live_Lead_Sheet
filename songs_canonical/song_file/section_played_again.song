# Canonical test song: crates/song_text/src/song_file.rs, test `a_section_named_twice_in_the_composition_plays_twice`.
# A and B are defined once; the composition plays A, B, A three times, B with repeat 0 (left out), then D. B's own 140 beats/min affects B only: A and D play at the composition's 100.
song "Sections played again"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "A"  meter 4/4
  line "Bass" | C2:w |

section "B"  meter 4/4
  tempo 140 beats/min
  line "Bass" | D2:w |

section "D"  meter 4/4
  line "Bass" | G2:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
  "B"
  "A"  repeat 3
  "B"  repeat 0
  "D"
song_composition_close
