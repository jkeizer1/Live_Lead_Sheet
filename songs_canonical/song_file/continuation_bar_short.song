# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `continuation_bar_short`.
# Bar 3 of the Keys line, on its second text line, is short. The loader must refuse it: names the text line that holds bar 3.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:w | V |
               | vi:h | IV:w |
