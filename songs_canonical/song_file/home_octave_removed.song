# Canonical test song: crates/song_text/src/song_file.rs, test home_octave_is_refused_and_says_what_replaced_it.
# A track with the removed home_octave setting: the loader must refuse it and name +8va, -8va and loco instead.
song "Home octave removed"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  home_octave 3

section "a"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | C4:w |
