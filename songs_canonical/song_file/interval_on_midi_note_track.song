# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `each_track_takes_only_its_own_notation`.
# "Beat" is a MIDI note track and writes the interval P5. The loader must refuse it at line 21 and say to write a note name.
song "Interval on beat"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef treble
  lead

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

section "Riff"  key C major  meter 4/4
  line "Keys"  | I:w |
  line "Beat"  | P5:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
song_composition_close
