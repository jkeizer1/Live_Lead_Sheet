# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_composition_without_meter_and_tempo_is_refused`.
# The song_composition header gives only the key. The loader must refuse it: it must say the header needs the key, meter and tempo.
song "T"
track "Clock"
  type clock_and_transport
track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead
section "A"  meter 4/4  key C major
  line "Bass"  tonic_octave 2 | P1:w |

song_composition
  key C major
  "A"
song_composition_close
