# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `missing_meter_and_tempo`.
# A section with a line but no meter and no tempo. The loader must refuse it: asks for the meter.
song "T"
track "Clock"
  type clock_and_transport
track "Bass"
  type mono_voice
  clef bass
  lead
section "A"
  line "Bass" | C2:w |
