# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `bars_after_a_setting`.
# Bars after a setting (repeat 2), which ends the line above. The loader must refuse it: bars with no line above them.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:w |
  repeat 2
  | V:w |
