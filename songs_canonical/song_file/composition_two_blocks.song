# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_song_has_exactly_one_composition`.
# Two song_composition blocks. The loader must refuse the second and say a song has only one.
song "Two compositions"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "Riff"  meter 4/4  key C major
  line "Bass"  tonic_octave 2 | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
song_composition_close

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
song_composition_close
