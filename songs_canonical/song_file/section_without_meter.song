# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_section_without_a_meter_is_refused`.
# "B" writes no meter. The loader must refuse it and say to add a meter: a section never takes its meter from the section before it.
song "No meter"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "A"  meter 4/4  key C major
  line "Bass"  tonic_octave 2 | P1:w |

section "B"  key C major
  line "Bass"  tonic_octave 3 | -P4:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
  "B"
song_composition_close
