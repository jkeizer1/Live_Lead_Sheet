# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `joined_lines_different_lengths`.
# Keys joined over two text lines is 3 bars; Bass is 2. The loader must refuse it: the lengths differ.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys"  | I:w | V |
               | vi |
  line "Bass"  tonic_octave 2  | P1:w | P5 |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
