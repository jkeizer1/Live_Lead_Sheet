# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `fractional_tempo_not_whole`.
# 4/16 at 100.001 beats/min is 0.25 milli-quarters per minute, not a whole number. The loader must refuse it: reported at the section line.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
track "Bass"
  type mono_voice
  clef bass
section "A"
  key C major  meter 4/16  tempo 100.001 beats/min
  line "Keys" | I:q |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
