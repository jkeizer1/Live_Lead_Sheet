# Canonical test song: crates/song_text/src/song_file.rs, test `a_section_with_repeat_0_is_left_out_as_if_commented_out`.
# Section B has repeat 0 and its own tempo; it is left out, and C (no tempo) carries A's tempo, not B's.
song "Repeat 0"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Bass" | C2:w |

section "B"
  tempo 140 beats/min
  line "Bass" | D2:w |

section "C"
  line "Bass" | G2:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"  repeat 2
  "B"  repeat 0
  "C"
song_composition_close
