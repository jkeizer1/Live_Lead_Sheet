# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_repeat_sign_inside_another_is_refused`.
# A repeat sign opened inside another. The loader must refuse it at line 12 and say signs do not nest.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" |% I:w |% V:w %| IV:w %|
