# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `chords_without_key`.
# Chords in a section that names no key. The loader must refuse it: says the section has chords but no key.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  clef treble
  lead
section "A"
  meter 4/4  tempo 120 beats/min
  line "Keys" | I:q / / / |
