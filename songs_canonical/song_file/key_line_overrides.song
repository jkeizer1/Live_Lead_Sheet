# Canonical test song: crates/song_text/src/song_file.rs, test `a_key_line_overrides_the_entries_below_it`.
# Every section is in C major. "Verse" plays C major (above the key line), "Chorus" its own override F major, "Interlude" the key line's E major, "Bridge" (key section) C major.
song "Key line"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

section "Verse"  key C major  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

section "Chorus"  key C major  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

section "Interlude"  key C major  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

section "Bridge"  key C major  meter 4/4
  line "Bass"  tonic_octave 2  | P1:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Verse"
  key E major
  "Chorus"  key F major
  "Interlude"
  "Bridge"  key section
song_composition_close
