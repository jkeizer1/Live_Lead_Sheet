# Canonical test song: crates/song_text/src/song_file.rs, test `a_section_written_again_must_be_defined_above`.
# The loader must refuse section "B" (no lines, and no earlier section named "B") and say to write its lines or define it above.
song "Not defined"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

section "A"
  key C major  meter 4/4  tempo 100 beats/min
  line "Bass" | C2:w |

section "B" repeat 2
