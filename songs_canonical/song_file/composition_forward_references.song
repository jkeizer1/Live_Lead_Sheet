# Canonical test song: crates/song_text/src/song_file.rs, test `a_section_defined_after_the_composition_plays`.
# The song_composition comes first and names sections defined below it (forward references), one of them twice.
song "Forward references"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  clef bass
  lead

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Verse"
  "Chorus"
  "Verse"
song_composition_close

section "Chorus"
  line "Bass" | G2:w |

section "Verse"
  line "Bass" | C2:w |
