# Canonical test song: crates/song_text/src/song_file.rs, test `a_section_defined_after_the_composition_plays`.
# The song_composition comes first and names sections defined below it (forward references), one of them twice.
song "Forward references"

track "Clock"
  type clock_and_transport

track "Bass"
  type mono_voice
  notes pitched
  clef bass
  lead

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Verse"
  "Chorus"
  "Verse"
song_composition_close

section "Chorus"  meter 4/4  key C major
  line "Bass"  tonic_octave 3 | -P4:w |

section "Verse"  meter 4/4  key C major
  line "Bass"  tonic_octave 2 | P1:w |
