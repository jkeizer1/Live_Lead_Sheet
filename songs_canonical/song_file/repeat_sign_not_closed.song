# Canonical test song (deliberately wrong): crates/song_text/src/song_file.rs, test `a_repeat_sign_not_closed_is_refused`.
# A repeat sign opened and never closed. The loader must refuse it at line 13 and say to close it with %|.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
section "A"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" | I:w |% V:w | IV:w |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "A"
song_composition_close
