# Canonical test song: crates/song_text/src/song_file.rs, test `a_midi_note_track_is_never_transposed`.
# "Beat" picks samples with C4, D4 and A4; the entry that overrides the key with Eb major moves the keys, not the beat's notes.
song "Sample beat"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  notes pitched
  clef treble
  lead

track "Beat"
  type mono_voice
  notes midi_note
  clef treble

section "Riff"  key C major  meter 4/4
  line "Keys"  tonic_octave 4  | P1:h M3 |
  line "Beat"  | C4:q D4 A4 / |

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "Riff"
  "Riff"  key Eb major
song_composition_close
