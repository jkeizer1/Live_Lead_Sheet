# Canonical test song (valid): crates/song_text/src/song_file.rs, test `repeat_signs_are_written_out`.
# Section "twice": |% ... %| plays twice, in the middle of a line. Section "three": |%3 plays three times. Section "carried": a / as the first bar of a group carries over the sign.
song "T"
track "Clock"
  type clock_and_transport
track "Keys"
  type poly_voice
  notes pitched
  clef grand
  lead
track "Bass"
  type mono_voice
  notes pitched
  clef bass
section "twice"
  key C major  meter 4/4  tempo 120 beats/min
  line "Keys" | I:w |% ii7:w | V:w %| IV:w |
  line "Bass"  tonic_octave 2 |% P1:w | P5:w | M2:w %|
section "three"  meter 4/4  key C major
  line "Keys" |%3 I:w %|
  line "Bass"  tonic_octave 2 |%3 P1:w %|
section "carried"  meter 4/4  key C major
  line "Keys" | I:w |% / %|
  line "Bass"  tonic_octave 2 | P1:w |% / %|

song_composition
  key C major  meter 4/4  tempo 100 beats/min
  "twice"
  "three"
  "carried"
song_composition_close
