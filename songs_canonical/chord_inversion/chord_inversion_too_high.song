# Canonical test song (deliberately wrong): crates/song_text/tests/chord_inversion_plan.rs, test `a_third_inversion_of_a_triad_is_refused`.
# I is a triad, so it has a first and a second inversion only. The loader must refuse [3rdInversion] at line 15 and say the highest is 2.
song "Chord inversion too high"

track "Clock"
  type clock_and_transport

track "Keys"
  type poly_voice
  clef grand
  lead

section "inversions"
  key C major  meter 4/4  tempo 100 beats/min
  line "Keys"  | I[3rdInversion]:w |
