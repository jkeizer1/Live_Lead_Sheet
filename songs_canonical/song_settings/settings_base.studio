# crates/composer/src/song_settings.rs, test the_studio_follows_a_rename_and_a_removal.
# A valid studio for settings_base.song: an output for each voice and the clock.
studio "Settings studio"

port "Clock"
port "Harmony"
port "Bass"
port "Beat pulse"

track "Clock"
  port "Clock"

track "Beat"
  port "Beat pulse"  channel 15

track "Keys"
  port "Harmony"  channel 1

track "Bass"
  port "Bass"  channel 2
