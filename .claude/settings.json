{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": false,
    "additionalDirectories": [
      "~/Documents/Linux_MIDI_Router"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(pkexec *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dpkg *)",
      "Bash(snap *)",
      "Bash(flatpak *)",
      "Bash(cargo install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.bash_history)"
    ],
   "allow": [
     "Bash(ls *)",
     "Bash(wc *)",
     "Bash(head *)",
     "Bash(grep *)",
     "Bash(git status *)",
     "Bash(git diff *)",
     "Bash(git log *)",
     "Bash(git show *)",
     "Bash(cargo build *)",
     "Bash(cargo test *)",
     "Bash(cargo clippy *)",
     "Bash(cargo fmt -p *)",
     "Bash(cargo tree *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cargo add *)",
      "Bash(cargo update *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.config",
        "~/.local/share/keyrings",
        "~/.mozilla",
        "~/.git-credentials",
        "~/.claude",
        "~/.claude.json",
        "~/.bash_history",
        "~/Documents"
      ],
      "allowRead": [
        "~/Documents/Live_Lead_Sheet",
        "~/Documents/Linux_MIDI_Router"
      ],
      "allowWrite": ["/home/jim/.cargo/registry", "/home/jim/.cargo/git"]
    },
    "network": {
      "allowedDomains": ["crates.io", "index.crates.io", "static.crates.io"]
    }
  }
}
